{
  "name": "arduino-mcp-extension",
  "version": "0.6.0",
  "description": "MCP (Model Context Protocol) server embedded in Arduino IDE - HTTP/SSE transport",
  "license": "AGPL-3.0-or-later",
  "main": "lib/node/arduino-mcp-backend-module",
  "types": "lib/node/arduino-mcp-backend-module",
  "keywords": [
    "theia-extension",
    "arduino",
    "mcp",
    "claude",
    "http",
    "sse"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@theia/core": "1.57.0",
    "arduino-ide-extension": "2.3.10",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/ws": "^8.5.10",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.5"
  },
  "theiaExtensions": [
    {
      "backend": "lib/node/arduino-mcp-backend-module",
      "frontend": "lib/browser/arduino-mcp-frontend-module"
    }
  ],
  "scripts": {
    "clean": "rimraf lib",
    "build": "tsc",
    "build:dev": "yarn build",
    "watch": "tsc -w"
  }
}
